{
  // Tests, e2e and config files run in Node, so they may use Node types (M32 T056, review D13). The browser code in src/ is checked by tsconfig.json without them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
