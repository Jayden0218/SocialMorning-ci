{
  // Browser code only: no Node types, so `process` or `Buffer` in src/ is a type error (M32 T056, review D13). Tests and config files: tsconfig.node.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
