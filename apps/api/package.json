{
  "name": "@socialmorning/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The social layer's HTTP API (specs/002-m3-social-layer/contracts/api.md). Hono on Node; one Vercel function in production, @hono/node-server locally.",
  "scripts": {
    "dev": "APP_ENV=dev DDB_TABLE_PREFIX=dev DDB_ENDPOINT=${DDB_ENDPOINT:-http://localhost:8000} tsx watch src/server.ts",
    "dev:ddb": "APP_ENV=dev DDB_TABLE_PREFIX=dev DDB_ENDPOINT=${DDB_ENDPOINT:-http://localhost:8000} tsx watch src/server.ts",
    "test": "tsx --test --test-timeout=120000 test/*.test.ts",
    "test:coverage": "c8 tsx --test --test-timeout=120000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "infra:build": "tsx infra/build-stack.ts",
    "build": "esbuild src/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --loader:.wasm=binary --loader:.woff=binary --outfile=api/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:lambda": "tsx scripts/build-lambda.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@hono/node-server": "^2.1.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@socialmorning/feed-parser": "*",
    "@socialmorning/social-core": "*",
    "@vercel/blob": "2.8.0",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "satori": "0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "age-encryption": "0.3.1",
    "autocannon": "8.0.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  }
}
