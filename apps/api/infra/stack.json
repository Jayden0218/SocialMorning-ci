{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SocialMorning API stack: DynamoDB tables, the API and worker Lambda functions, outbox trigger, schedules, log groups. One stack per environment (Env = stg | sm). Generated by apps/api/infra/build-stack.ts — do not edit by hand.",
  "Parameters": {
    "Env": {
      "Type": "String",
      "AllowedValues": [
        "stg",
        "sm"
      ],
      "Description": "stg = staging, sm = production. Prefixes every resource name."
    },
    "ApiRoleArn": {
      "Type": "String",
      "Description": "The Lambda execution role the owner created (<Env>-api-lambda-role)."
    },
    "SchedulerRoleArn": {
      "Type": "String",
      "Description": "The EventBridge Scheduler role the owner created (<Env>-scheduler-role)."
    }
  },
  "Conditions": {
    "IsProd": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "sm"
      ]
    }
  },
  "Resources": {
    "Main": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-main"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "GSI1",
            "KeySchema": [
              {
                "AttributeName": "G1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t"
              ]
            }
          },
          {
            "IndexName": "GSI2",
            "KeySchema": [
              {
                "AttributeName": "G2PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G2SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "durationMs",
                "hidden"
              ]
            }
          },
          {
            "IndexName": "GSI3",
            "KeySchema": [
              {
                "AttributeName": "G3PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G3SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "feedKey"
              ]
            }
          },
          {
            "IndexName": "GSI4",
            "KeySchema": [
              {
                "AttributeName": "G4PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G4SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "GSI5",
            "KeySchema": [
              {
                "AttributeName": "G5PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G5SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          },
          {
            "IndexName": "GSI6",
            "KeySchema": [
              {
                "AttributeName": "G6PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G6SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "displayName",
                "avatarUrl"
              ]
            }
          }
        ],
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProd",
            true,
            false
          ]
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": {
            "Fn::If": [
              "IsProd",
              true,
              false
            ]
          }
        }
      }
    },
    "Events": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Main",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-events"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "EV1",
            "KeySchema": [
              {
                "AttributeName": "E1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "E1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ],
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProd",
            true,
            false
          ]
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": {
            "Fn::If": [
              "IsProd",
              true,
              false
            ]
          }
        }
      }
    },
    "Cache": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Events",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-cache"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "DeletionProtectionEnabled": false,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Env}-api"
        },
        "RetentionInDays": {
          "Fn::If": [
            "IsProd",
            14,
            3
          ]
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Env}-worker"
        },
        "RetentionInDays": {
          "Fn::If": [
            "IsProd",
            14,
            3
          ]
        }
      }
    },
    "Api": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Env}-api"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 1024,
        "Timeout": 30,
        "Handler": "index.handler",
        "Role": {
          "Ref": "ApiRoleArn"
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 503, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ error: 'not deployed yet' }) });"
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "Api",
            "Arn"
          ]
        },
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED"
      }
    },
    "ApiUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ApiUrlInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "WorkerLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Env}-worker"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 300,
        "Handler": "index.handler",
        "Role": {
          "Ref": "ApiRoleArn"
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 503, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ error: 'not deployed yet' }) });"
        }
      }
    },
    "OutboxTrigger": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Main",
            "StreamArn"
          ]
        },
        "StartingPosition": "LATEST",
        "BatchSize": 50,
        "MaximumBatchingWindowInSeconds": 1,
        "MaximumRetryAttempts": 3,
        "BisectBatchOnFunctionError": true,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{\"eventName\":[\"INSERT\"],\"dynamodb\":{\"Keys\":{\"PK\":{\"S\":[{\"prefix\":\"OUTBOX#\"}]}}}}"
            }
          ]
        }
      }
    },
    "DrainEveryMinute": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-outbox-drain"
        },
        "ScheduleExpression": "rate(1 minute)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"drain\"}"
        }
      }
    },
    "JobsHourly": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-jobs-hourly"
        },
        "ScheduleExpression": "cron(17 * * * ? *)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"jobs\"}"
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Description": "The API address (Lambda Function URL).",
      "Value": {
        "Fn::GetAtt": [
          "ApiUrl",
          "FunctionUrl"
        ]
      }
    }
  }
}
