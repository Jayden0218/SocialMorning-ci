{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SocialMorning API stack: DynamoDB tables, the API and worker Lambda functions, outbox trigger, schedules, log groups. One stack per environment (Env = stg | sm). Generated by apps/api/infra/build-stack.ts — do not edit by hand.",
  "Parameters": {
    "Env": {
      "Type": "String",
      "AllowedValues": [
        "stg",
        "sm"
      ],
      "Description": "stg = staging, sm = production. Prefixes every resource name."
    },
    "ApiRoleArn": {
      "Type": "String",
      "Description": "The Lambda execution role the owner created (<Env>-api-lambda-role)."
    },
    "SchedulerRoleArn": {
      "Type": "String",
      "Description": "The EventBridge Scheduler role the owner created (<Env>-scheduler-role)."
    },
    "AlertEmail": {
      "Type": "String",
      "Default": "",
      "Description": "M28: where the production alarm topic sends email. Empty = the topic has no subscriber."
    },
    "ApiReserved": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "M28: reserved concurrency for the API function. 0 = none (the account limit may not allow one)."
    },
    "WorkerReserved": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "M28: reserved concurrency for the worker function. 0 = none."
    }
  },
  "Conditions": {
    "IsProd": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "sm"
      ]
    },
    "HasApiReserved": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApiReserved"
            },
            0
          ]
        }
      ]
    },
    "HasWorkerReserved": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "WorkerReserved"
            },
            0
          ]
        }
      ]
    },
    "HasAlertEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlertEmail"
            },
            ""
          ]
        }
      ]
    },
    "ProdAlertEmail": {
      "Fn::And": [
        {
          "Condition": "IsProd"
        },
        {
          "Condition": "HasAlertEmail"
        }
      ]
    }
  },
  "Resources": {
    "Main": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-main"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "GSI1",
            "KeySchema": [
              {
                "AttributeName": "G1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t"
              ]
            }
          },
          {
            "IndexName": "GSI2",
            "KeySchema": [
              {
                "AttributeName": "G2PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G2SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "durationMs",
                "hidden"
              ]
            }
          },
          {
            "IndexName": "GSI3",
            "KeySchema": [
              {
                "AttributeName": "G3PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G3SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "feedKey"
              ]
            }
          },
          {
            "IndexName": "GSI4",
            "KeySchema": [
              {
                "AttributeName": "G4PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G4SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "GSI5",
            "KeySchema": [
              {
                "AttributeName": "G5PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G5SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          },
          {
            "IndexName": "GSI6",
            "KeySchema": [
              {
                "AttributeName": "G6PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G6SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "displayName",
                "avatarUrl"
              ]
            }
          }
        ],
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProd",
            true,
            false
          ]
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "Events": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Main",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-events"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "EV1",
            "KeySchema": [
              {
                "AttributeName": "E1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "E1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ],
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProd",
            true,
            false
          ]
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "Cache": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Events",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-cache"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "SSESpecification": {
          "SSEEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "DeletionProtectionEnabled": false,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Env}-api"
        },
        "RetentionInDays": {
          "Fn::If": [
            "IsProd",
            14,
            3
          ]
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Env}-worker"
        },
        "RetentionInDays": {
          "Fn::If": [
            "IsProd",
            14,
            3
          ]
        }
      }
    },
    "Api": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Env}-api"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 1024,
        "Timeout": 30,
        "Handler": "index.handler",
        "Role": {
          "Ref": "ApiRoleArn"
        },
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "HasApiReserved",
            {
              "Ref": "ApiReserved"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "SECRETS_PATH": {
              "Fn::Sub": "/${Env}/api/"
            }
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 503, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ error: 'not deployed yet' }) });"
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "Api",
            "Arn"
          ]
        },
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED"
      }
    },
    "ApiUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ApiUrlInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "WorkerLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Env}-worker"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 300,
        "Handler": "index.handler",
        "Role": {
          "Ref": "ApiRoleArn"
        },
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "HasWorkerReserved",
            {
              "Ref": "WorkerReserved"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "SECRETS_PATH": {
              "Fn::Sub": "/${Env}/api/"
            },
            "SECRETS_REQUIRED": "JOB_TOKEN"
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 503, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ error: 'not deployed yet' }) });"
        }
      }
    },
    "WorkerDlq": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${Env}-worker-dlq"
        },
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "OutboxFailed": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${Env}-outbox-failed"
        },
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "WorkerAsync": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 2,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "WorkerDlq",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "OutboxTrigger": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Main",
            "StreamArn"
          ]
        },
        "StartingPosition": "LATEST",
        "BatchSize": 50,
        "ParallelizationFactor": 1,
        "MaximumBatchingWindowInSeconds": 1,
        "MaximumRetryAttempts": 3,
        "MaximumRecordAgeInSeconds": 3600,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "OutboxFailed",
                "Arn"
              ]
            }
          }
        },
        "BisectBatchOnFunctionError": true,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{\"eventName\":[\"INSERT\"],\"dynamodb\":{\"Keys\":{\"PK\":{\"S\":[{\"prefix\":\"OUTBOX#\"}]}}}}"
            }
          ]
        }
      }
    },
    "DrainEveryMinute": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-outbox-drain"
        },
        "ScheduleExpression": "rate(1 minute)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"drain\"}",
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "WorkerDlq",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 2,
            "MaximumEventAgeInSeconds": 3600
          }
        }
      }
    },
    "JobsHourly": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-jobs-hourly"
        },
        "ScheduleExpression": "cron(17 * * * ? *)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"jobs\"}",
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "WorkerDlq",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 2,
            "MaximumEventAgeInSeconds": 3600
          }
        }
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Condition": "IsProd",
      "Properties": {
        "TopicName": "sm-alerts"
      }
    },
    "AlertsEmail": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "ProdAlertEmail",
      "Properties": {
        "TopicArn": {
          "Ref": "Alerts"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      }
    },
    "AlarmApi5xx": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-api-5xx"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#api-5xx — The API answered 5 or more server errors in 5 minutes",
        "Namespace": "AWS/Lambda",
        "MetricName": "Url5xxCount",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Api"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 5,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmApiSlow": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-api-slow"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#api-slow — The API p95 latency is over 500 ms for 15 minutes",
        "Namespace": "AWS/Lambda",
        "MetricName": "UrlRequestLatency",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Api"
            }
          }
        ],
        "ExtendedStatistic": "p95",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 500,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmApiThrottled": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-api-throttled"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#api-throttled — The API function was throttled",
        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Api"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmWorkerErrors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-worker-errors"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#worker-errors — The worker function failed in two 15-minute periods in a row",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 900,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmWorkerThrottled": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-worker-throttled"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#worker-throttled — The worker function was throttled",
        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 900,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmStreamLag": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-stream-lag"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#stream-lag — The outbox stream is more than 5 minutes behind",
        "Namespace": "AWS/Lambda",
        "MetricName": "IteratorAge",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 300000,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "AlarmDlqVisible": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "IsProd",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${Env}-failed-jobs"
        },
        "AlarmDescription": "docs/runbooks/alarms.md#failed-jobs — A scheduled or worker invocation failed and is waiting in the dead-letter queue",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
