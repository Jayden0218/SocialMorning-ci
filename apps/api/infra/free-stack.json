{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SocialMorning free environments (dev, qa): provisioned DynamoDB tables inside the free 25/25 units, the outbox worker Lambda, its Stream mapping and schedules, and the IAM policy for the Vercel API user. Deploy once per Env. Generated by apps/api/infra/build-free-stack.ts — do not edit by hand.",
  "Parameters": {
    "Env": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "qa"
      ],
      "Description": "dev or qa. Prefixes every resource name."
    },
    "WorkerRoleArn": {
      "Type": "String",
      "Description": "The Lambda execution role the owner created for the worker (<Env>-worker-role)."
    },
    "SchedulerRoleArn": {
      "Type": "String",
      "Description": "The EventBridge Scheduler role the owner created (<Env>-scheduler-role)."
    }
  },
  "Resources": {
    "Main": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-main"
        },
        "BillingMode": "PROVISIONED",
        "TableClass": "STANDARD",
        "DeletionProtectionEnabled": false,
        "SSESpecification": {
          "SSEEnabled": false
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G1SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G2SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G3SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G4SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G5SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "G6SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "GSI1",
            "KeySchema": [
              {
                "AttributeName": "G1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t"
              ]
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          },
          {
            "IndexName": "GSI2",
            "KeySchema": [
              {
                "AttributeName": "G2PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G2SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "durationMs",
                "hidden"
              ]
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          },
          {
            "IndexName": "GSI3",
            "KeySchema": [
              {
                "AttributeName": "G3PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G3SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "title",
                "image",
                "feedKey"
              ]
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          },
          {
            "IndexName": "GSI4",
            "KeySchema": [
              {
                "AttributeName": "G4PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G4SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          },
          {
            "IndexName": "GSI5",
            "KeySchema": [
              {
                "AttributeName": "G5PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G5SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          },
          {
            "IndexName": "GSI6",
            "KeySchema": [
              {
                "AttributeName": "G6PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "G6SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "INCLUDE",
              "NonKeyAttributes": [
                "t",
                "displayName",
                "avatarUrl"
              ]
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 3,
          "WriteCapacityUnits": 3
        }
      }
    },
    "Events": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Main",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-events"
        },
        "BillingMode": "PROVISIONED",
        "TableClass": "STANDARD",
        "DeletionProtectionEnabled": false,
        "SSESpecification": {
          "SSEEnabled": false
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "E1SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "EV1",
            "KeySchema": [
              {
                "AttributeName": "E1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "E1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            },
            "ProvisionedThroughput": {
              "ReadCapacityUnits": 1,
              "WriteCapacityUnits": 1
            }
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 1,
          "WriteCapacityUnits": 1
        }
      }
    },
    "Cache": {
      "Type": "AWS::DynamoDB::Table",
      "DependsOn": "Events",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Fn::Sub": "${Env}-cache"
        },
        "BillingMode": "PROVISIONED",
        "TableClass": "STANDARD",
        "DeletionProtectionEnabled": false,
        "SSESpecification": {
          "SSEEnabled": false
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 1,
          "WriteCapacityUnits": 1
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Env}-worker"
        },
        "RetentionInDays": 3
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "WorkerLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Env}-worker"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 60,
        "Handler": "index.handler",
        "Role": {
          "Ref": "WorkerRoleArn"
        },
        "Environment": {
          "Variables": {
            "APP_ENV": {
              "Ref": "Env"
            },
            "DATA_BACKEND": "ddb",
            "DDB_TABLE_PREFIX": {
              "Ref": "Env"
            },
            "SECRETS_PATH": {
              "Fn::Sub": "/${Env}/api/"
            },
            "SECRETS_REQUIRED": "JOB_TOKEN"
          }
        },
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 503, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ error: 'not deployed yet' }) });"
        }
      }
    },
    "OutboxTrigger": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Main",
            "StreamArn"
          ]
        },
        "StartingPosition": "LATEST",
        "BatchSize": 50,
        "ParallelizationFactor": 1,
        "MaximumBatchingWindowInSeconds": 1,
        "MaximumRetryAttempts": 3,
        "MaximumRecordAgeInSeconds": 3600,
        "BisectBatchOnFunctionError": true,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{\"eventName\":[\"INSERT\"],\"dynamodb\":{\"Keys\":{\"PK\":{\"S\":[{\"prefix\":\"OUTBOX#\"}]}}}}"
            }
          ]
        }
      }
    },
    "DrainEveryMinute": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-outbox-drain"
        },
        "ScheduleExpression": "rate(1 minute)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"drain\"}",
          "RetryPolicy": {
            "MaximumRetryAttempts": 2,
            "MaximumEventAgeInSeconds": 3600
          }
        }
      }
    },
    "JobsHourly": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Env}-jobs-hourly"
        },
        "ScheduleExpression": "rate(1 hour)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Worker",
              "Arn"
            ]
          },
          "RoleArn": {
            "Ref": "SchedulerRoleArn"
          },
          "Input": "{\"kind\":\"jobs\"}",
          "RetryPolicy": {
            "MaximumRetryAttempts": 2,
            "MaximumEventAgeInSeconds": 3600
          }
        }
      }
    },
    "VercelApiPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": {
          "Fn::Sub": "${Env}-vercel-api-ddb"
        },
        "Description": "Data access for the Vercel-hosted API of this environment: the three tables and their indexes, no table management.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TablesAndIndexes",
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchGetItem",
                "dynamodb:BatchWriteItem",
                "dynamodb:ConditionCheckItem",
                "dynamodb:DescribeTable"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Main",
                    "Arn"
                  ]
                },
                {
                  "Fn::GetAtt": [
                    "Events",
                    "Arn"
                  ]
                },
                {
                  "Fn::GetAtt": [
                    "Cache",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Main.Arn}/index/*"
                },
                {
                  "Fn::Sub": "${Events.Arn}/index/*"
                },
                {
                  "Fn::Sub": "${Cache.Arn}/index/*"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "MainTableName": {
      "Value": {
        "Ref": "Main"
      }
    },
    "EventsTableName": {
      "Value": {
        "Ref": "Events"
      }
    },
    "CacheTableName": {
      "Value": {
        "Ref": "Cache"
      }
    },
    "MainTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "Main",
          "Arn"
        ]
      }
    },
    "EventsTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "Events",
          "Arn"
        ]
      }
    },
    "CacheTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "Cache",
          "Arn"
        ]
      }
    },
    "MainStreamArn": {
      "Value": {
        "Fn::GetAtt": [
          "Main",
          "StreamArn"
        ]
      }
    },
    "WorkerName": {
      "Value": {
        "Ref": "Worker"
      }
    },
    "VercelApiPolicyArn": {
      "Description": "Attach this to the IAM user whose access key the Vercel API project uses.",
      "Value": {
        "Ref": "VercelApiPolicy"
      }
    }
  }
}
