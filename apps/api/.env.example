# Copy to apps/api/.env (gitignored). Never paste real values into chat, commits or logs.
# Every variable the API reads is listed here — test/env-example.test.ts fails when the code reads one that is missing.
# Staging and prod on AWS take these from the private repo's GitHub secrets via the deploy workflows
# (docs/runbooks/m26-aws-setup.md); nothing AWS-related goes in a file.

# ---- Required everywhere -------------------------------------------------------------------------------------
# Signs session tokens. 32+ random characters (openssl rand -hex 32). Staging and prod use different values.
SESSION_PEPPER=change-me-32-random-bytes-base64url
# dev | staging | prod. Unset: a Vercel production deploy counts as prod, anything else as dev. prod refuses Google test purchases.
APP_ENV=dev
# The API runs on DynamoDB only. DATA_BACKEND may be left unset; any value but ddb is refused.
# DATA_BACKEND=ddb

# ---- DynamoDB -----------------------------------------------------------------------------
# DynamoDB Local only (scripts/ddb-local.sh). Never set on staging or prod.
# DDB_ENDPOINT=http://localhost:8000
# Table prefix: stg on staging, sm on prod, anything else (dev) locally.
# DDB_TABLE_PREFIX=dev
# AWS region; Lambda sets it. Default ap-southeast-1.
# AWS_REGION=ap-southeast-1
# Signs list cursors. Unset: derived from SESSION_PEPPER.
# CURSOR_SECRET=
# Set by the Lambda runtime itself (config.ts uses it to tell "inside AWS"). Do not set it by hand.
# AWS_LAMBDA_FUNCTION_NAME=

# ---- Optional features ---------------------------------------------------------------------------------------
# Email sign-in codes: the owner's Gmail + a 16-letter app password (myaccount.google.com/apppasswords; needs 2-Step Verification). Unset: /v1/auth/code is 503.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Bearer token for POST /v1/internal/rebuild (the hourly jobs). Unset: the route is closed.
# JOB_TOKEN=
# The second pepper during a secret rotation (docs/runbooks/secret-rotation.md).
# PEPPER_NEXT=
# The one moderator's listener id, and the address the suspension messages name. Unset: /mod is off.
# OWNER_LISTENER_ID=
# APPEALS_EMAIL=
# Where new kinds of server error are emailed. Unset: the owner's own address.
# ALERT_EMAIL=
# Android App Links file and the published build's SHA-256 shown on /get.
# ASSETLINKS_SHA256=
# RELEASE_SHA256=
# This API's public address and the Studio's (links in shares and invitations).
# PUBLIC_API_URL=https://socialmorning-api.vercel.app
# STUDIO_URL=https://socialmorning-studio.vercel.app
# Groq free tier for translated transcripts. Unset: translation jobs stay queued.
# GROQ_API_KEY=
# Vercel Blob stores: voice posts, hosted episodes, comment/status images.
# BLOB_READ_WRITE_TOKEN=
# EPISODES_READ_WRITE_TOKEN=
# IMAGES_READ_WRITE_TOKEN=
# Limits: total image store (bytes), feedback images (bytes), sign-in codes per day.
# IMAGE_CEILING_BYTES=500000000
# FEEDBACK_IMAGE_CEILING_BYTES=
# CODE_DAILY_CAP=
# Maintenance banner (the owner can also switch it in /mod).
# MAINTENANCE_UNTIL=
# MAINTENANCE_MESSAGE=
# Google Play purchases. Unset: purchases say "not available yet".
# GOOGLE_PLAY_SA_JSON=
# GOOGLE_PLAY_PACKAGE=
# Google test purchases: on everywhere except APP_ENV=prod, where only this switch (=1) allows them.
# ALLOW_TEST_PURCHASES=1
# Port for the Node server (default 3000).
# PORT=3000

# ---- Legacy (kept readable, decide nothing new) --------------------------------------------------------------
# Cloudflare R2 image store; replaced by the Vercel Blob store (constitution v3.2.1).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE=
# Set by Vercel itself. Only used to read APP_ENV's default.
# VERCEL_ENV=

# ---- Deploying on Vercel (until the cutover) ------------------------------------------------------------------
# Vercel only creates the api/index function when apps/api/api/index.js EXISTS in the upload (it is gitignored
# build output; `npm run build` overwrites it on Vercel). From a clean checkout, create a placeholder first, or every
# route answers 500 (found 2026-09-27: the deploy ran Vercel's own src/app.ts entry instead).
# Set APP_ENV=prod on the Vercel API project: then test purchases stay refused even without VERCEL_ENV (M27).

# ---- Edge address (M28 US2; set on the Lambda only when the Vercel edge proxy is in use) ---------------------
# Shared secret the edge proxy signs with (x-sm-edge). Unset = the Function URL's own sourceIp is counted.
# EDGE_SECRET=
# The edge proxy's origin: the API Lambda's Function URL. Read by src/edge-proxy.ts (a Vercel function, not deployed yet).
# FUNCTION_URL=

# ---- Secrets from Parameter Store (M28 US6; set on the Lambda functions only) ----------------------------------
# Inside Lambda, with this set, the secrets (SESSION_PEPPER, PEPPER_NEXT, JOB_TOKEN, CURSOR_SECRET, GMAIL_APP_PASSWORD, GROQ_API_KEY,
# the Blob tokens, EDGE_SECRET) are read from SSM SecureString parameters under this path and re-read every 15 minutes
# (src/secrets.ts). Unset, or anywhere but Lambda (Vercel, Node, tests): the environment is read as before. The deploy
# workflows set it when secrets_from=ssm.
# SECRETS_PATH=/stg/api/
# Names that must exist under SECRETS_PATH besides SESSION_PEPPER (comma list); the stack sets JOB_TOKEN on the worker.
# SECRETS_REQUIRED=JOB_TOKEN

# ---- Small provisioned indexes (M32; the dev and qa environments of spec 032 give the indexes 1 RCU) -----------------
# 1 makes the day-index reads (Discover pool, plays) go one day (9 Queries) at a time instead of six days (54) at once; throttled
# Queries are retried either way. Leave unset on prod and staging (on-demand tables). Set it on the dev and qa API, in the Vercel
# env AND the worker Lambda env, when specs 032 and 034 meet.
# DDB_LOW_THROUGHPUT=1
