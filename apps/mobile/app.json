{
  "expo": {
    "name": "SocialNet",
    "slug": "socialmorning",
    "scheme": "socialmorning",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.socialmorning.mobile"
    },
    "android": {
      "package": "app.socialmorning.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FDC621",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "socialmorning-api.vercel.app",
              "pathPrefix": "/c/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-router",
      "expo-secure-store",
      "./plugins/without-push-entitlement",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "SocialNet uses the camera only to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SocialNet uses your photos only when you add an image to feedback.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialmorning-api.vercel.app",
      "router": {},
      "eas": {
        "projectId": "8b3962aa-134d-4f46-a881-e9cbda7fb2a1"
      }
    },
    "owner": "jayden0218s-team"
  }
}
