+    while reader.status == .reading, let buffer = output.copyNextSampleBuffer() {
+      guard let block = CMSampleBufferGetDataBuffer(buffer) else {
+        continue
+      }
+      let count = CMBlockBufferGetDataLength(block) / MemoryLayout<Float>.size
+      if count == 0 {
+        continue
+      }
+      if samples.count < count {
+        samples = [Float](repeating: 0, count: count)
+      }
+      let copied = samples.withUnsafeMutableBytes { raw -> OSStatus in
+        guard let base = raw.baseAddress else {
+          return OSStatus(-1)
+        }
+        return CMBlockBufferCopyDataBytes(block, atOffset: 0, dataLength: count * MemoryLayout<Float>.size, destination: base)
+      }
+      if copied != noErr {
