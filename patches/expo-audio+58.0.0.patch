+        continue
+      }
+      for index in 0..<count {
+        let sample = samples[index]
+        windowSum += sample * sample
+        windowCount += 1
+        if windowCount == window {
+          let windowStart = framesRead + index + 1 - window
+          if windowSum / Float(window) < quietSquared {
+            if silentSince == nil {
+              silentSince = windowStart
+            }
+          } else if let start = silentSince {
+            addRange(start, windowStart)
+            silentSince = nil
+          }
+          windowSum = 0
+          windowCount = 0
+        }
+      }
+      framesRead += count
+    }
+    if let start = silentSince {
+      addRange(start, framesRead)
+    }
+    return ranges
+  }
