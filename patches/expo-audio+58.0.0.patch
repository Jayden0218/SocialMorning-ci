+// SocialNet patch (M21 US11, 2026-10-06): voice boost. The chain, per channel: a high-pass at
+// 100 Hz (rumble out), a +5 dB peak at 2 kHz (the speech band up), a compressor (-24 dBFS, 3:1,
+// 5 ms / 120 ms) with +6 dB make-up, then a hard limiter at -0.5 dBFS. Coefficients are worked
+// out once in tapPrepare from the processing format's sample rate; tapProcess only reads them,
+// so the audio thread never allocates or locks. Biquads are written out by hand (transposed
+// direct form II), not vDSP_biquad, so no setup object has to be created or freed.
+#define SN_BOOST_MAX_CHANNELS 8
+#define SN_BOOST_HIGHPASS_HZ 100.0
+#define SN_BOOST_PEAK_HZ 2000.0
+#define SN_BOOST_PEAK_DB 5.0
+#define SN_BOOST_PEAK_Q 1.0
+#define SN_BOOST_THRESHOLD 0.0631f   /* -24 dBFS */
+#define SN_BOOST_RATIO 3.0f
+#define SN_BOOST_MAKEUP 1.9953f      /* +6 dB */
+#define SN_BOOST_CEILING 0.9441f     /* -0.5 dBFS */
+
+typedef struct {
+  float b0, b1, b2, a1, a2;
+} SNBiquad;
+
+typedef struct {
+  Boolean ready;      // float32 PCM and a sample rate: the chain can run
+  Boolean wasOn;      // the state is cleared when boost is switched back on
+  SNBiquad highPass;
+  SNBiquad peak;
+  float attack;
+  float release;
+  float hpZ1[SN_BOOST_MAX_CHANNELS];
+  float hpZ2[SN_BOOST_MAX_CHANNELS];
+  float pkZ1[SN_BOOST_MAX_CHANNELS];
+  float pkZ2[SN_BOOST_MAX_CHANNELS];
+  float envelope[SN_BOOST_MAX_CHANNELS];
+} SNVoiceBoost;
