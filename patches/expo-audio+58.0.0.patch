+/// RBJ cookbook, normalised by a0.
+static SNBiquad snHighPass(double sampleRate, double hz, double q) {
+  double w0 = 2.0 * M_PI * hz / sampleRate;
+  double cosw = cos(w0);
+  double alpha = sin(w0) / (2.0 * q);
+  double a0 = 1.0 + alpha;
+  SNBiquad c;
+  c.b0 = (float)(((1.0 + cosw) / 2.0) / a0);
+  c.b1 = (float)(-(1.0 + cosw) / a0);
+  c.b2 = (float)(((1.0 + cosw) / 2.0) / a0);
+  c.a1 = (float)((-2.0 * cosw) / a0);
+  c.a2 = (float)((1.0 - alpha) / a0);
+  return c;
+}
 
+static SNBiquad snPeak(double sampleRate, double hz, double q, double gainDb) {
+  double a = pow(10.0, gainDb / 40.0);
+  double w0 = 2.0 * M_PI * hz / sampleRate;
+  double cosw = cos(w0);
+  double alpha = sin(w0) / (2.0 * q);
+  double a0 = 1.0 + alpha / a;
+  SNBiquad c;
+  c.b0 = (float)((1.0 + alpha * a) / a0);
+  c.b1 = (float)((-2.0 * cosw) / a0);
+  c.b2 = (float)((1.0 - alpha * a) / a0);
+  c.a1 = (float)((-2.0 * cosw) / a0);
+  c.a2 = (float)((1.0 - alpha / a) / a0);
+  return c;
+}
+
+static inline float snRun(const SNBiquad *c, float x, float *z1, float *z2) {
+  float y = c->b0 * x + *z1;
+  *z1 = c->b1 * x - c->a1 * y + *z2;
+  *z2 = c->b2 * x - c->a2 * y;
+  return y;
+}
+
+/// Runs the chain over every buffer and every channel, in place. Audio thread: no allocation, no lock.
+static void snVoiceBoostProcess(SNVoiceBoost *boost, AudioBufferList *list, CMItemCount frames) {
+  if (!boost->ready || !list || frames <= 0) {
+    return;
+  }
+  if (!boost->wasOn) {
+    memset(boost->hpZ1, 0, sizeof(boost->hpZ1));
+    memset(boost->hpZ2, 0, sizeof(boost->hpZ2));
+    memset(boost->pkZ1, 0, sizeof(boost->pkZ1));
+    memset(boost->pkZ2, 0, sizeof(boost->pkZ2));
+    memset(boost->envelope, 0, sizeof(boost->envelope));
+    boost->wasOn = true;
+  }
+  UInt32 channel = 0;
+  for (UInt32 b = 0; b < list->mNumberBuffers; b++) {
+    AudioBuffer *buffer = &list->mBuffers[b];
+    UInt32 channels = buffer->mNumberChannels > 0 ? buffer->mNumberChannels : 1;
+    if (!buffer->mData) {
+      channel += channels;
+      continue;
+    }
+    float *samples = (float *)buffer->mData;
+    CMItemCount bufferFrames = (CMItemCount)(buffer->mDataByteSize / (sizeof(float) * channels));
+    if (bufferFrames > frames) {
+      bufferFrames = frames;
+    }
+    for (UInt32 c = 0; c < channels; c++, channel++) {
+      if (channel >= SN_BOOST_MAX_CHANNELS) {
+        continue;
+      }
+      float env = boost->envelope[channel];
+      for (CMItemCount i = 0; i < bufferFrames; i++) {
+        float *sample = &samples[i * channels + c];
+        float y = snRun(&boost->highPass, *sample, &boost->hpZ1[channel], &boost->hpZ2[channel]);
+        y = snRun(&boost->peak, y, &boost->pkZ1[channel], &boost->pkZ2[channel]);
+        float level = fabsf(y);
+        env = level > env ? boost->attack * env + (1.0f - boost->attack) * level
+                          : boost->release * env + (1.0f - boost->release) * level;
+        float gain = env > SN_BOOST_THRESHOLD ? powf(env / SN_BOOST_THRESHOLD, (1.0f / SN_BOOST_RATIO) - 1.0f) : 1.0f;
+        y *= gain * SN_BOOST_MAKEUP;
+        if (y > SN_BOOST_CEILING) {
+          y = SN_BOOST_CEILING;
+        } else if (y < -SN_BOOST_CEILING) {
+          y = -SN_BOOST_CEILING;
+        }
+        *sample = y;
+      }
+      boost->envelope[channel] = env;
+    }
+  }
+}
