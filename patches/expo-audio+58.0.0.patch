+
+    let window = Int(scanSampleRate * 0.02)
+    let quietSquared = silenceLevel * silenceLevel
+    var ranges: [CMTimeRange] = []
+    var samples = [Float](repeating: 0, count: 4_096)
+    var windowSum: Float = 0
+    var windowCount = 0
+    var framesRead = 0
+    var silentSince: Int?
+
+    func addRange(_ startFrame: Int, _ endFrame: Int) {
+      let length = Double(endFrame - startFrame) / scanSampleRate
+      let start = Double(startFrame) / scanSampleRate + cutLeadSeconds
+      let end = Double(endFrame) / scanSampleRate - cutTailSeconds
+      guard length >= cutMinimumSeconds, end - start > 0.2 else {
+        return
+      }
+      ranges.append(CMTimeRange(
+        start: CMTime(seconds: start, preferredTimescale: 1_000),
+        end: CMTime(seconds: end, preferredTimescale: 1_000)
+      ))
+    }
