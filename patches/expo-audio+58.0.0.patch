+package expo.modules.audio.service
+
+import android.net.Uri
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MediaMetadata
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * SocialNet patch (M10b, Android Auto): what the car can browse, set by the app's JS as JSON
+ * `{"sections":[{"id","title","items":[{"id","title","subtitle","artworkUrl"}]}]}`, and the
+ * pick sent back to JS, which plays it through its own player. No JS running (the app is not
+ * open) → one line asking to open the app on the phone.
+ */
+object CarLibrary {
+  const val ROOT_ID = "socialnet-root"
+  private const val OPEN_APP_ID = "socialnet-open-app"
+  private const val EPISODE = "ep:"
+
+  @Volatile private var sections: JSONArray = JSONArray()
+  @Volatile var onSelect: ((String) -> Unit)? = null
+  @Volatile var onChanged: ((List<String>) -> Unit)? = null
+
+  fun set(json: String) {
+    sections = try { JSONObject(json).optJSONArray("sections") ?: JSONArray() } catch (e: Exception) { JSONArray() }
+    onChanged?.invoke(listOf(ROOT_ID) + sectionIds())
+  }
+
+  fun root(): MediaItem = folder(ROOT_ID, "SocialNet")
+
+  fun children(parentId: String): List<MediaItem> {
+    val s = sections
+    if (parentId == ROOT_ID) {
+      if (s.length() == 0) return listOf(note(OPEN_APP_ID, "Open SocialNet on your phone"))
+      return (0 until s.length()).map { i -> s.getJSONObject(i).let { folder(it.optString("id"), it.optString("title")) } }
+    }
+    for (i in 0 until s.length()) {
+      val section = s.getJSONObject(i)
+      if (section.optString("id") != parentId) continue
+      val items = section.optJSONArray("items") ?: return emptyList()
+      return (0 until items.length()).map { j -> episode(items.getJSONObject(j)) }
+    }
+    return emptyList()
+  }
+
+  fun item(mediaId: String): MediaItem? {
+    if (mediaId == ROOT_ID) return root()
+    return (listOf(ROOT_ID) + sectionIds()).flatMap { children(it) }.firstOrNull { it.mediaId == mediaId }
+  }
+
+  /** The car asked to play `mediaId`: hand the episode id to JS. False when it is not an episode or JS is gone. */
+  fun select(mediaId: String?): Boolean {
+    if (mediaId == null || !mediaId.startsWith(EPISODE)) return false
+    val send = onSelect ?: return false
+    send(mediaId.removePrefix(EPISODE))
+    return true
+  }
+
+  /**
+   * The service is exported so the car can reach it; only these may browse the lists: Android
+   * Auto, Google's car apps, the system (trusted), and the app itself. Playback controls are
+   * unchanged (expo-audio's onConnect).
+   */
+  private val BROWSERS = setOf("com.google.android.projection.gearhead", "com.google.android.carassistant", "com.android.car.media")
+  fun mayBrowse(packageName: String, trusted: Boolean, ownPackage: String): Boolean =
+    trusted || packageName == ownPackage || packageName in BROWSERS
+
+  private fun sectionIds(): List<String> = sections.let { s -> (0 until s.length()).map { s.getJSONObject(it).optString("id") } }
+
+  private fun folder(id: String, title: String) = MediaItem.Builder().setMediaId(id).setMediaMetadata(
+    MediaMetadata.Builder().setTitle(title).setIsBrowsable(true).setIsPlayable(false)
+      .setMediaType(MediaMetadata.MEDIA_TYPE_FOLDER_PODCASTS).build()
+  ).build()
+
+  private fun note(id: String, title: String) = MediaItem.Builder().setMediaId(id).setMediaMetadata(
+    MediaMetadata.Builder().setTitle(title).setIsBrowsable(false).setIsPlayable(false).build()
+  ).build()
+
+  private fun episode(o: JSONObject): MediaItem {
+    val art = o.optString("artworkUrl")
+    return MediaItem.Builder().setMediaId(EPISODE + o.optString("id")).setMediaMetadata(
+      MediaMetadata.Builder().setTitle(o.optString("title")).setArtist(o.optString("subtitle"))
+        .apply { if (art.isNotEmpty()) setArtworkUri(Uri.parse(art)) }
+        .setIsBrowsable(false).setIsPlayable(true)
+        .setMediaType(MediaMetadata.MEDIA_TYPE_PODCAST_EPISODE).build()
+    ).build()
+  }
+}
