    </item>

    <item>
      <title>Prose duration and a nonsense date</title>
      <guid>ep-prose</guid>
      <enclosure url="https://cdn.example.com/4.mp3"/>
      <itunes:duration>about an hour</itunes:duration>
      <pubDate>sometime last Tuesday</pubDate>
    </item>

    <!-- Not an episode: nothing to play. -->
    <item>
      <title>Announcement with no media</title>
      <guid>ep-no-media</guid>
      <description>We are on a break.</description>
    </item>

    <!-- Protocol-relative, and path-relative, enclosure urls. -->
    <item>
      <title>Protocol relative</title>
      <guid>ep-protorel</guid>
      <enclosure url="//cdn.example.com/5.mp3" type="audio/mpeg"/>
    </item>

    <item>
      <title>Path relative</title>
      <guid>ep-pathrel</guid>
      <enclosure url="media/6.mp3" type="audio/mpeg"/>
    </item>

    <!-- No guid at all: identity has to come from the enclosure. -->
    <item>
      <title>No guid</title>
      <enclosure url="https://cdn.example.com/7.mp3"/>
    </item>

    <!-- A re-posted item carrying a guid already used above. -->
    <item>
      <title>Duplicate of the first</title>
      <guid isPermaLink="false">ep-colon</guid>
      <enclosure url="https://cdn.example.com/8.mp3"/>
    </item>

    <!-- A numeric-looking guid. Must stay a STRING. -->
    <item>
      <title>Numeric guid</title>
      <guid>0123</guid>
      <enclosure url="https://cdn.example.com/9.mp3"/>
      <podcast:transcript url="https://cdn.example.com/9.vtt" type="text/vtt" language="en"/>
