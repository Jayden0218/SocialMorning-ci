    <itunes:image href="https://cdn.example.com/art.jpg"/>
    <itunes:category text="Technology">
      <itunes:category text="Software How-To"/>
    </itunes:category>

    <!-- Durations in every shape the wild produces. -->
    <item>
      <title>Colon form</title>
      <guid isPermaLink="false">ep-colon</guid>
      <enclosure url="https://cdn.example.com/1.mp3" type="audio/mpeg" length="12345"/>
      <itunes:duration>1:02:03</itunes:duration>
      <pubDate>Tue, 10 Sep 2024 09:00:00 GMT</pubDate>
      <description>Plain text version, truncated&#8230;</description>
      <content:encoded><![CDATA[<p>The <b>full</b> shownotes.</p>]]></content:encoded>
    </item>

    <item>
      <title>Seconds form</title>
      <guid>ep-seconds</guid>
      <enclosure url="https://cdn.example.com/2.mp3" type="audio/mpeg" length="0"/>
      <itunes:duration>3723</itunes:duration>
      <pubDate>2024-09-11T09:00:00Z</pubDate>
    </item>

    <item>
      <title>Minutes over sixty</title>
      <guid>ep-overflow</guid>
      <enclosure url="https://cdn.example.com/3.mp3"/>
