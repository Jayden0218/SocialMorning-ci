{
  "name": "@socialmorning/feed-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RSS ingestion for the podcast client. Pure TypeScript: no node: imports, so it runs on the phone as well as on the server (research R6).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
